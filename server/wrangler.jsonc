{
	"name": "blog-website-server",
	"main": "src/express.ts",
	"compatibility_date": "2026-10-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"CLIENT_URL": "https://blog-website.outryvball04.workers.dev"
	},
	"d1_databases": [
		{
			"binding": "blog_db",
			"database_name": "blog-db",
			"database_id": "ec718db7-c739-4d75-81c9-afd2bc460ab1",
			"remote": false
		}
	],
	"previews": {
		"d1_databases": [
			{
				"binding": "blog_db",
				"database_name": "preview-blog-db",
				"database_id": "4a9940f3-17f9-40b8-9255-b47a52d4b884"
			}
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}